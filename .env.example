# ---- Evidra environment template ----
# Copy to backend/.env for local dev:  copy backend/.env.example backend/.env
# Copy to .env for docker compose root: copy .env.example .env

# App
APP_NAME=Evidra API
APP_ENV=dev
API_V1_PREFIX=/api/v1

# MongoDB (document persistence for studies, claims, comparison matrices)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=evidra

# LLM — OpenAI-compatible API (works with OpenAI, OpenCode, or any custom BASE_URL)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-change-me
OPENAI_MODEL=gpt-4o-mini

# MongoDB auth for docker compose (change before first boot, then `down -v` to re-apply)
MONGO_USER=evidra
MONGO_PASSWORD=evidra-dev-only-change-me
MONGO_DB=evidra

# Search & Retrieval
SERPAPI_API_KEY=
S2_API_KEY=

# Frontend -> Backend wiring (must include the /api/v1 prefix or requests 404)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---- Evidra backend env template ----
# Copy to .env for local dev:  copy .env.example .env  (Windows) / cp .env.example .env
APP_NAME=Evidra API
APP_ENV=dev
API_V1_PREFIX=/api/v1
MONGO_URL=mongodb://localhost:27017
MONGO_DB=evidra
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
# Free-tier LLM pacing: min seconds between request starts (5 RPM -> 12.0). 0 disables.
LLM_MIN_INTERVAL_SECONDS=12.0
# Transient 429/503 retries (after the first attempt) and max honored retry delay.
LLM_MAX_RETRIES=2
LLM_MAX_RETRY_DELAY_SECONDS=75.0
SERPAPI_API_KEY=
S2_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Evidra backend env template ----
# Copy to .env for local dev:  copy .env.example .env  (Windows) / cp .env.example .env
APP_NAME=Evidra API
APP_ENV=dev
API_V1_PREFIX=/api/v1
MONGO_URL=mongourl.....
MONGO_DB=evidra
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
# Rotation pool: comma-separated keys (tried in order, 3 concurrent max).
# Falls back to GROQ_API_KEY, then OPENAI_API_KEY when empty.
#GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
#GROQ_API_KEY=
# Free-tier LLM pacing: min seconds between request starts (5 RPM -> 12.0). 0 disables.
LLM_MIN_INTERVAL_SECONDS=12.0
# Transient 429/503 retries per model (1 initial + 3 retries = 4 attempts).
LLM_MAX_RETRIES=3
LLM_MAX_RETRY_DELAY_SECONDS=75.0
# Failover model when the primary is still rate-limited after all retries.
OPENAI_FALLBACK_MODEL=llama-3.1-8b-instant
SERPAPI_API_KEY=
S2_API_KEY=
# Frontend only (Next.js reads NEXT_PUBLIC_* from its own env, not this
# file — see frontend/.env.example). Must include the API prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
